<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OpenQCY_Desktop.Views.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF181E27"
    RequestedTheme="Dark">

    <Border
        Background="#FF181E27"
        CornerRadius="22">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="18" Spacing="14">
            <Grid Height="44" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Width="44" Height="44" Background="{StaticResource OpenQCYAccentStrongBrush}" CornerRadius="14">
                        <FontIcon Glyph="&#xE95B;" FontSize="21" />
                    </Border>
                    <StackPanel MaxWidth="182" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource OpenQCYAccentStrongBrush}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button Width="36" Height="36" CornerRadius="18" Style="{StaticResource RoundIconButtonStyle}" Click="OpenDesktop_Click" ToolTipService.ToolTip="Abrir configurações">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                    <Button Width="36" Height="36" CornerRadius="18" Style="{StaticResource RoundIconButtonStyle}" Click="Close_Click" ToolTipService.ToolTip="Fechar painel">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                    <Button Width="36" Height="36" CornerRadius="18" Style="{StaticResource RoundIconButtonStyle}" Click="Exit_Click" ToolTipService.ToolTip="Sair do OpenQCY">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Height="58" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="10,8" Background="#0FFFFFFF" CornerRadius="14"><StackPanel Spacing="2"><TextBlock Style="{StaticResource CaptionStyle}" Text="Esquerdo" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.LeftBatteryDisplay, Mode=OneWay}" /></StackPanel></Border>
                <Border Grid.Column="1" Padding="10,8" Background="#0FFFFFFF" CornerRadius="14"><StackPanel Spacing="2"><TextBlock Style="{StaticResource CaptionStyle}" Text="Direito" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.RightBatteryDisplay, Mode=OneWay}" /></StackPanel></Border>
                <Border Grid.Column="2" Padding="10,8" Background="#0FFFFFFF" CornerRadius="14"><StackPanel Spacing="2"><TextBlock Style="{StaticResource CaptionStyle}" Text="Estojo" /><TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.CaseBatteryDisplay, Mode=OneWay}" /></StackPanel></Border>
            </Grid>

            <Border Padding="15" Background="#0FFFFFFF" CornerRadius="18">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Controle de ruído" />
                    <RadioButtons
                        ItemsSource="{x:Bind ViewModel.NoiseModes}"
                        SelectedItem="{x:Bind ViewModel.SelectedNoiseMode, Mode=TwoWay}" />
                    <Border
                        x:Name="NoiseCancellationDetails"
                        x:Load="{x:Bind ViewModel.IsNoiseCancellationSelected, Mode=OneWay}"
                        Padding="10"
                        Background="#0CFFFFFF"
                        BorderBrush="#16FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Modo de cancelamento" />
                            <RadioButtons
                                MaxColumns="2"
                                ItemsSource="{x:Bind ViewModel.NoiseCancellationModes}"
                                SelectedItem="{x:Bind ViewModel.SelectedNoiseCancellationMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Height="82" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="10" Background="#0FFFFFFF" CornerRadius="16">
                    <StackPanel Spacing="4">
                        <Grid>
                            <Border Width="28" Height="28" HorizontalAlignment="Left" Background="#1C55A8FF" CornerRadius="9">
                                <FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="{StaticResource OpenQCYBlueBrush}" />
                            </Border>
                            <ToggleSwitch
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Detecção de uso"
                                OffContent=""
                                OnContent=""
                                IsOn="{x:Bind ViewModel.WearDetection, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Detecção de uso" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="10" Background="#0FFFFFFF" CornerRadius="16">
                    <StackPanel Spacing="4">
                        <Grid>
                            <Border Width="28" Height="28" HorizontalAlignment="Left" Background="#1CFFB35C" CornerRadius="9">
                                <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="#FFFFB35C" />
                            </Border>
                            <ToggleSwitch
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Modo jogo"
                                OffContent=""
                                OnContent=""
                                IsOn="{x:Bind ViewModel.GameModeEnabled, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Modo jogo" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource OpenQCYAccentBrush}" Text="CONTROLE QCY VALIDADO" />
                <TextBlock MaxHeight="34" Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
