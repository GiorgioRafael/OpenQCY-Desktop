<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenQCY_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="BatteryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource OpenQCYMutedBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource OpenQCYSidebarBrush}"
            BorderBrush="{StaticResource OpenQCYStrokeBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="42"
                        Height="42"
                        Background="{StaticResource OpenQCYAccentStrongBrush}"
                        CornerRadius="14">
                        <FontIcon Glyph="&#xE95B;" FontSize="21" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="OpenQCY" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Desktop" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,22,0,18"
                    Padding="12"
                    Background="#12FFFFFF"
                    BorderBrush="{StaticResource OpenQCYStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#1837D88A" CornerRadius="17">
                            <FontIcon Glyph="&#xE702;" FontSize="16" Foreground="{StaticResource OpenQCYAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="MeloBuds N70" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Controle BLE local" />
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource OpenQCYAccentStrongBrush}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="4">
                    <Button x:Name="OverviewNavButton" Tag="Overview" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}" Background="#16FFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Visão geral" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SoundNavButton" Tag="Sound" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE767;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Som" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ControlsNavButton" Tag="Controls" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE815;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Controles" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionNavButton" Tag="Connection" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE702;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Conexão" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GeneralNavButton" Tag="General" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Geral" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="8">
                    <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                    <StackPanel Margin="8,8,8,0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource OpenQCYMutedBrush}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Controle local · sem conta ou firmware" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#59080C12">
            <ScrollViewer x:Name="OverviewSection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Bom te ver por aqui." />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Seus QCY MeloBuds N70, agora sob controle do PC." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.DiscoverDevicesCommand}" Style="{StaticResource RoundIconButtonStyle}" ToolTipService.ToolTip="Atualizar estado">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>

                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Controle Bluetooth real do N70"
                        Message="{x:Bind ViewModel.DiscoveryStatus, Mode=OneWay}" />

                    <StackPanel Margin="4,-10,4,0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE702;" FontSize="12" Foreground="{StaticResource OpenQCYMutedBrush}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.DiscoveryStatus, Mode=OneWay}" />
                    </StackPanel>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="58" Height="58" Background="#1837D88A" CornerRadius="20">
                                        <FontIcon Glyph="&#xE95B;" FontSize="28" Foreground="{StaticResource OpenQCYAccentBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource OpenQCYAccentStrongBrush}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource OpenQCYAccentBrush}" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.FirmwareVersion, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource BatteryLabelStyle}" Text="Esquerdo" />
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.LeftBatteryDisplay, Mode=OneWay}" />
                                        <ProgressBar Height="4" Value="{x:Bind ViewModel.LeftBattery, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource BatteryLabelStyle}" Text="Direito" />
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.RightBatteryDisplay, Mode=OneWay}" />
                                        <ProgressBar Height="4" Value="{x:Bind ViewModel.RightBattery, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Style="{StaticResource BatteryLabelStyle}" Text="Estojo" />
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.CaseBatteryDisplay, Mode=OneWay}" />
                                        <ProgressBar Height="4" Value="{x:Bind ViewModel.CaseBattery, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Top" Glyph="&#xE895;" FontSize="12" Foreground="{StaticResource OpenQCYAccentBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="{x:Bind ViewModel.BatteryStatus, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1" Padding="20" Background="#10000000" CornerRadius="18">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Controle de ruído" />
                                        <TextBlock Margin="8,2,0,0" Style="{StaticResource CaptionStyle}" Text="sincronizado com o fone" />
                                    </StackPanel>
                                    <RadioButtons
                                        ItemsSource="{x:Bind ViewModel.NoiseModes}"
                                        SelectedItem="{x:Bind ViewModel.SelectedNoiseMode, Mode=TwoWay}" />
                                    <Border
                                        x:Name="NoiseCancellationDetails"
                                        x:Load="{x:Bind ViewModel.IsNoiseCancellationSelected, Mode=OneWay}"
                                        Padding="13,11"
                                        Background="#0CFFFFFF"
                                        BorderBrush="#16FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel Spacing="8">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Modo de cancelamento" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="Escolha o perfil ideal para o ambiente." />
                                            </StackPanel>
                                            <RadioButtons
                                                MaxColumns="2"
                                                ItemsSource="{x:Bind ViewModel.NoiseCancellationModes}"
                                                SelectedItem="{x:Bind ViewModel.SelectedNoiseCancellationMode, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE995;" FontSize="14" Foreground="{StaticResource OpenQCYBlueBrush}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Toque para alternar. A escolha permanece salva entre reinicializações." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CompactGlassCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#1C55A8FF" CornerRadius="13">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="17" Foreground="{StaticResource OpenQCYBlueBrush}" />
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.WearDetection, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Detecção de uso" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Desative para impedir pausas automáticas ao retirar ou recolocar o fone." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CompactGlassCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#1C66D6A3" CornerRadius="13">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="{StaticResource OpenQCYAccentBrush}" />
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.MultipointEnabled, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Multiponto" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Mantenha celular e PC prontos para alternar a reprodução." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CompactGlassCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#1CFFB35C" CornerRadius="13">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="17" Foreground="#FFFFB35C" />
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.GameModeEnabled, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Modo jogo" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Prioriza latência baixa para jogos e vídeos no computador." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Perfil persistente do N70" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" Text="O OpenQCY reaplicará estas preferências quando o fone se conectar ao PC." />
                                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource OpenQCYAccentBrush}" Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ApplyProfileCommand}" Style="{StaticResource AccentButtonStyle}" Content="Aplicar perfil" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SoundSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Som" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Ajuste a assinatura sonora e os modos de escuta." />
                    </StackPanel>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="18">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Equalizador" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.EqualizerCapabilityStatus, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                    <ComboBox Width="170" IsEnabled="{x:Bind ViewModel.EqualizerPresetsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.EqualizerPresets}" SelectedItem="{x:Bind ViewModel.SelectedEqualizerPreset, Mode=TwoWay}" />
                                    <Button Command="{x:Bind ViewModel.ResetEqualizerCommand}" Content="Redefinir" />
                                    <Button Command="{x:Bind ViewModel.ApplyEqualizerCommand}" IsEnabled="{x:Bind ViewModel.EqualizerSupported, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Content="Aplicar" />
                                </StackPanel>
                            </Grid>

                            <Grid Height="245" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand1, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="31" /></StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand2, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="62" /></StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand3, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="125" /></StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand4, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="250" /></StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand5, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="500" /></StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand6, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="1k" /></StackPanel>
                                <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand7, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="2k" /></StackPanel>
                                <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand8, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="4k" /></StackPanel>
                                <StackPanel Grid.Column="8" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand9, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="8k" /></StackPanel>
                                <StackPanel Grid.Column="9" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand10, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="16k" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompactGlassCardStyle}">
                            <Grid>
                                <StackPanel MaxWidth="310" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="LDAC" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Preferir alta qualidade quando o perfil estiver disponível." />
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.LdacEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactGlassCardStyle}">
                            <Grid>
                                <StackPanel MaxWidth="310" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Redução de vento" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Suaviza ruído de vento durante o cancelamento ativo." />
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.WindReductionEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Volume dos avisos" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Tons e mensagens do próprio fone." />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.PromptVolume, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ViewModel.PromptVolumeDisplay, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ControlsSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Controles" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Personalize cada gesto sem depender do aplicativo móvel." />
                    </StackPanel>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Toques" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource CaptionStyle}" Text="Disponível quando o canal de gestos do fone estiver conectado." />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Dois toques · esquerdo" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.LeftDoubleTap, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Dois toques · direito" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.RightDoubleTap, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Pressionar · esquerdo" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.LeftLongPress, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Pressionar · direito" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.RightLongPress, Mode=TwoWay}" /></Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompactGlassCardStyle}">
                            <Grid><StackPanel MaxWidth="300" HorizontalAlignment="Left"><TextBlock Style="{StaticResource CardTitleStyle}" Text="Detecção de uso" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Desative para resolver as pausas ao tirar ou colocar um dos lados." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.WearDetection, Mode=TwoWay}" /></Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactGlassCardStyle}">
                            <Grid><StackPanel MaxWidth="300" HorizontalAlignment="Left"><TextBlock Style="{StaticResource CardTitleStyle}" Text="Modo sono" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Bloqueia gestos acidentais enquanto estiver ativado." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.SleepModeEnabled, Mode=TwoWay}" /></Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConnectionSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Conexão" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Gerencie como o N70 se comporta entre PC e celular." /></StackPanel>
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Multiponto" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Conexão simultânea com dois dispositivos." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.MultipointEnabled, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Reaplicar automaticamente" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Restaura seu perfil sempre que o N70 aparecer no Windows." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoApplyEnabled, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Desligamento automático" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Tempo configurado no gerenciador de energia dos fones." /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DisconnectTimeouts}" SelectedItem="{x:Bind ViewModel.DisconnectTimeout, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Canal de controle" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Varredura BLE, serviço A001 e notificações QCY." /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Command="{x:Bind ViewModel.DiscoverDevicesCommand}" Content="Conectar / atualizar" /><Button Command="{x:Bind ViewModel.DisconnectDeviceCommand}" Content="Desconectar" /></StackPanel></Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Encontrar meus fones" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Emitirá um som em cada lado quando o protocolo estiver validado. Não use com os fones nos ouvidos." /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button IsEnabled="False" Content="Esquerdo" /><Button IsEnabled="False" Content="Direito" /></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GeneralSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Geral" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Persistência, inicialização e informações do projeto." /></StackPanel>
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Perfil local" /><TextBlock Style="{StaticResource CaptionStyle}" Text="As preferências são armazenadas somente neste computador." /></StackPanel><Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.SaveProfileCommand}" Content="Salvar agora" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Reaplicar ao conectar" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Mantém sua configuração estável mesmo depois de usar o celular." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoApplyEnabled, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Executar com o Windows" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Disponível quando o instalador estiver pronto." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsEnabled="False" /></Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompactGlassCardStyle}">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="52" Height="52" Background="{StaticResource OpenQCYAccentStrongBrush}" CornerRadius="17"><FontIcon Glyph="&#xE95B;" FontSize="24" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Text="OpenQCY Desktop" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Código aberto · sem conta · sem atualização de firmware · não afiliado à QCY" /></StackPanel></Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
