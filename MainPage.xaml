<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenQCY_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="BatteryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource OpenQCYMutedBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource OpenQCYSidebarBrush}"
            BorderBrush="{StaticResource OpenQCYStrokeBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="42"
                        Height="42"
                        Background="{StaticResource OpenQCYAccentStrongBrush}"
                        CornerRadius="14">
                        <FontIcon Glyph="&#xE95B;" FontSize="21" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="OpenQCY" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Desktop" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,22,0,18"
                    Padding="12"
                    Background="#12FFFFFF"
                    BorderBrush="{StaticResource OpenQCYStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#1837D88A" CornerRadius="17">
                            <FontIcon Glyph="&#xE702;" FontSize="16" Foreground="{StaticResource OpenQCYAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="MeloBuds N70" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="Local BLE control" />
                        </StackPanel>
                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource OpenQCYAccentStrongBrush}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="4">
                    <Button x:Name="OverviewNavButton" Tag="Overview" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}" Background="#16FFFFFF">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Overview" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SoundNavButton" Tag="Sound" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE767;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Sound" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ControlsNavButton" Tag="Controls" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE815;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Controls" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionNavButton" Tag="Connection" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE702;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="Connection" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GeneralNavButton" Tag="General" Click="SectionButton_Click" Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock VerticalAlignment="Center" Text="General" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="8">
                    <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                    <StackPanel Margin="8,8,8,0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource OpenQCYMutedBrush}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Local control · no account or firmware" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#59080C12">
            <ScrollViewer x:Name="OverviewSection" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Good to see you." />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Your QCY MeloBuds N70, now controlled from your PC." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{x:Bind ViewModel.DiscoverDevicesCommand}" Style="{StaticResource RoundIconButtonStyle}" ToolTipService.ToolTip="Refresh status">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>

                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Real N70 Bluetooth control"
                        Message="{x:Bind ViewModel.DiscoveryStatus, Mode=OneWay}" />

                    <StackPanel Margin="4,-10,4,0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE702;" FontSize="12" Foreground="{StaticResource OpenQCYMutedBrush}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.DiscoveryStatus, Mode=OneWay}" />
                    </StackPanel>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="58" Height="58" Background="#1837D88A" CornerRadius="20">
                                        <FontIcon Glyph="&#xE95B;" FontSize="28" Foreground="{StaticResource OpenQCYAccentBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeviceName, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource OpenQCYAccentStrongBrush}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource OpenQCYAccentBrush}" Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.FirmwareVersion, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource BatteryLabelStyle}" Text="Left" />
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.LeftBatteryDisplay, Mode=OneWay}" />
                                        <ProgressBar Height="4" Value="{x:Bind ViewModel.LeftBattery, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource BatteryLabelStyle}" Text="Right" />
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.RightBatteryDisplay, Mode=OneWay}" />
                                        <ProgressBar Height="4" Value="{x:Bind ViewModel.RightBattery, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Style="{StaticResource BatteryLabelStyle}" Text="Case" />
                                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{x:Bind ViewModel.CaseBatteryDisplay, Mode=OneWay}" />
                                        <ProgressBar Height="4" Value="{x:Bind ViewModel.CaseBattery, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Top" Glyph="&#xE895;" FontSize="12" Foreground="{StaticResource OpenQCYAccentBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="{x:Bind ViewModel.BatteryStatus, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1" Padding="20" Background="#10000000" CornerRadius="18">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Noise control" />
                                        <TextBlock Margin="8,2,0,0" Style="{StaticResource CaptionStyle}" Text="synced with the earbuds" />
                                    </StackPanel>
                                    <RadioButtons
                                        ItemsSource="{x:Bind ViewModel.NoiseModes}"
                                        SelectedItem="{x:Bind ViewModel.SelectedNoiseMode, Mode=TwoWay}" />
                                    <Border
                                        x:Name="NoiseCancellationDetails"
                                        x:Load="{x:Bind ViewModel.IsNoiseCancellationSelected, Mode=OneWay}"
                                        Padding="13,11"
                                        Background="#0CFFFFFF"
                                        BorderBrush="#16FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel Spacing="8">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Cancellation mode" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="Choose the best profile for your surroundings." />
                                            </StackPanel>
                                            <RadioButtons
                                                MaxColumns="2"
                                                ItemsSource="{x:Bind ViewModel.NoiseCancellationModes}"
                                                SelectedItem="{x:Bind ViewModel.SelectedNoiseCancellationMode, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE995;" FontSize="14" Foreground="{StaticResource OpenQCYBlueBrush}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Select a mode to switch. Your choice is saved across restarts." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CompactGlassCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#1C55A8FF" CornerRadius="13">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="17" Foreground="{StaticResource OpenQCYBlueBrush}" />
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.WearDetection, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Wear detection" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Turn it off to prevent automatic pauses when removing or reinserting an earbud." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CompactGlassCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#1C66D6A3" CornerRadius="13">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="{StaticResource OpenQCYAccentBrush}" />
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.MultipointEnabled, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Multipoint" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Keep your phone and PC ready to switch playback." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CompactGlassCardStyle}">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#1CFFB35C" CornerRadius="13">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="17" Foreground="#FFFFB35C" />
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.GameModeEnabled, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Game mode" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Prioritizes low latency for games and videos on your PC." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Persistent N70 profile" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionStyle}" Text="OpenQCY will reapply these preferences when the earbuds connect to your PC." />
                                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource OpenQCYAccentBrush}" Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.ApplyProfileCommand}" Style="{StaticResource AccentButtonStyle}" Content="Apply profile" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SoundSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Sound" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Tune the sound signature and listening modes." />
                    </StackPanel>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="18">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Equalizer" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.EqualizerCapabilityStatus, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                    <ComboBox Width="170" IsEnabled="{x:Bind ViewModel.EqualizerPresetsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.EqualizerPresets}" SelectedItem="{x:Bind ViewModel.SelectedEqualizerPreset, Mode=TwoWay}" />
                                    <Button Command="{x:Bind ViewModel.ResetEqualizerCommand}" Content="Reset" />
                                    <Button Command="{x:Bind ViewModel.ApplyEqualizerCommand}" IsEnabled="{x:Bind ViewModel.EqualizerSupported, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Content="Apply" />
                                </StackPanel>
                            </Grid>

                            <Grid Height="245" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand1, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="31" /></StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand2, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="62" /></StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand3, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="125" /></StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand4, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="250" /></StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand5, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="500" /></StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand6, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="1k" /></StackPanel>
                                <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand7, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="2k" /></StackPanel>
                                <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand8, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="4k" /></StackPanel>
                                <StackPanel Grid.Column="8" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand9, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="8k" /></StackPanel>
                                <StackPanel Grid.Column="9" HorizontalAlignment="Center" Spacing="8"><Slider Height="190" Minimum="-8" Maximum="8" StepFrequency="0.5" Orientation="Vertical" Value="{x:Bind ViewModel.EqBand10, Mode=TwoWay}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="16k" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompactGlassCardStyle}">
                            <Grid>
                                <StackPanel MaxWidth="310" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="LDAC" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Prefer high quality when the profile is available." />
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.LdacEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactGlassCardStyle}">
                            <Grid>
                                <StackPanel MaxWidth="310" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Wind reduction" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Softens wind noise while active noise cancellation is enabled." />
                                </StackPanel>
                                <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.WindReductionEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Prompt volume" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Tones and voice prompts from the earbuds." />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.PromptVolume, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ViewModel.PromptVolumeDisplay, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ControlsSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Controls" />
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Customize each gesture without relying on the mobile app." />
                    </StackPanel>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Touch controls" />
                            <TextBlock Margin="0,0,0,12" Style="{StaticResource CaptionStyle}" Text="Available when the earbuds' gesture channel is connected." />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Double tap · left" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.LeftDoubleTap, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Double tap · right" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.RightDoubleTap, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Press and hold · left" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.LeftLongPress, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid Padding="0,12" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Press and hold · right" /><ComboBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.KeyFunctionsSupported, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TouchActions}" SelectedItem="{x:Bind ViewModel.RightLongPress, Mode=TwoWay}" /></Grid>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompactGlassCardStyle}">
                            <Grid><StackPanel MaxWidth="300" HorizontalAlignment="Left"><TextBlock Style="{StaticResource CardTitleStyle}" Text="Wear detection" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Turn it off to prevent pauses when removing or reinserting either earbud." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.WearDetection, Mode=TwoWay}" /></Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactGlassCardStyle}">
                            <Grid><StackPanel MaxWidth="300" HorizontalAlignment="Left"><TextBlock Style="{StaticResource CardTitleStyle}" Text="Sleep mode" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Blocks accidental gestures while enabled." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.SleepModeEnabled, Mode=TwoWay}" /></Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConnectionSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connection" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Manage how the N70 behaves between your PC and phone." /></StackPanel>
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Multipoint" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Connect to two devices at the same time." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.MultipointEnabled, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Reapply automatically" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Restores your profile whenever the N70 appears in Windows." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoApplyEnabled, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Automatic power off" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Timeout configured in the earbuds' power manager." /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DisconnectTimeouts}" SelectedItem="{x:Bind ViewModel.DisconnectTimeout, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Control channel" /><TextBlock Style="{StaticResource CaptionStyle}" Text="BLE scanning, A001 service, and QCY notifications." /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Command="{x:Bind ViewModel.DiscoverDevicesCommand}" Content="Connect / refresh" /><Button Command="{x:Bind ViewModel.DisconnectDeviceCommand}" Content="Disconnect" /></StackPanel></Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Find my earbuds" /><TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="Plays a sound in each earbud once the protocol is validated. Do not use while wearing them." /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button IsEnabled="False" Content="Left" /><Button IsEnabled="False" Content="Right" /></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GeneralSection" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="960" Padding="38,28,38,44" HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="General" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource OpenQCYMutedBrush}" Text="Persistence, startup, and project information." /></StackPanel>
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Local profile" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Preferences are stored only on this computer." /></StackPanel><Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.SaveProfileCommand}" Content="Save now" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Reapply on connection" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Keeps your setup consistent even after using the mobile app." /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoApplyEnabled, Mode=TwoWay}" /></Grid>
                            <Border Height="1" Background="{StaticResource OpenQCYStrokeBrush}" />
                            <Grid><StackPanel><TextBlock Style="{StaticResource CardTitleStyle}" Text="Run at Windows startup" /><TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" /></StackPanel><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.RunAtStartupEnabled, Mode=TwoWay}" /></Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompactGlassCardStyle}">
                        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="52" Height="52" Background="{StaticResource OpenQCYAccentStrongBrush}" CornerRadius="17"><FontIcon Glyph="&#xE95B;" FontSize="24" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="17" FontWeight="SemiBold" Text="OpenQCY Desktop" /><TextBlock Style="{StaticResource CaptionStyle}" Text="Open source · no account · no firmware updates · not affiliated with QCY" /></StackPanel></Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
