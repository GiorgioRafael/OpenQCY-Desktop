<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OpenQCY_Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="OpenQCYBackgroundColor">#FF080C12</Color>
            <Color x:Key="OpenQCYSidebarColor">#C7151B24</Color>
            <Color x:Key="OpenQCYCardColor">#B8232A35</Color>
            <Color x:Key="OpenQCYCardHoverColor">#D12B3441</Color>
            <Color x:Key="OpenQCYStrokeColor">#26FFFFFF</Color>
            <Color x:Key="OpenQCYMutedColor">#FFA9B0BB</Color>
            <Color x:Key="OpenQCYAccentColor">#FF66D6A3</Color>
            <Color x:Key="OpenQCYAccentStrongColor">#FF27C282</Color>
            <Color x:Key="OpenQCYBlueColor">#FF55A8FF</Color>

            <SolidColorBrush x:Key="OpenQCYBackgroundBrush" Color="{StaticResource OpenQCYBackgroundColor}" />
            <SolidColorBrush x:Key="OpenQCYSidebarBrush" Color="{StaticResource OpenQCYSidebarColor}" />
            <SolidColorBrush x:Key="OpenQCYCardBrush" Color="{StaticResource OpenQCYCardColor}" />
            <SolidColorBrush x:Key="OpenQCYCardHoverBrush" Color="{StaticResource OpenQCYCardHoverColor}" />
            <SolidColorBrush x:Key="OpenQCYStrokeBrush" Color="{StaticResource OpenQCYStrokeColor}" />
            <SolidColorBrush x:Key="OpenQCYMutedBrush" Color="{StaticResource OpenQCYMutedColor}" />
            <SolidColorBrush x:Key="OpenQCYAccentBrush" Color="{StaticResource OpenQCYAccentColor}" />
            <SolidColorBrush x:Key="OpenQCYAccentStrongBrush" Color="{StaticResource OpenQCYAccentStrongColor}" />
            <SolidColorBrush x:Key="OpenQCYBlueBrush" Color="{StaticResource OpenQCYBlueColor}" />

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OpenQCYCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenQCYStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <Style x:Key="CompactGlassCardStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OpenQCYMutedBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="RoundIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="21" />
                <Setter Property="Background" Value="#16FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenQCYStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
